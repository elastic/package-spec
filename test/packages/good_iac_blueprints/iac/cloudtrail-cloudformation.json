[
  {
    "op": "add",
    "path": "/Resources/ElasticFederatedRole/Properties/Policies/-",
    "value": {
      "PolicyName": "ElasticCloudTrailReadAccess",
      "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "s3:GetObject",
              "s3:ListBucket"
            ],
            "Resource": [
              "arn:aws:s3:::my-cloudtrail-bucket",
              "arn:aws:s3:::my-cloudtrail-bucket/*"
            ]
          }
        ]
      }
    }
  }
]
